{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "model": "fable[1m]",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/doubl/anaconda3/python.exe C:/Users/doubl/.claude/hooks/prisma-session-start.py",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/doubl/anaconda3/python.exe C:/Users/doubl/.claude/hooks/ferry.py land",
            "timeout": 30
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/doubl/anaconda3/python.exe C:/Users/doubl/.claude/hooks/ferry.py flush",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/doubl/anaconda3/python.exe C:/Users/doubl/.claude/hooks/prisma-stop-check.py",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/doubl/anaconda3/python.exe C:/Users/doubl/.claude/hooks/ferry.py archive",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/doubl/anaconda3/python.exe C:/Users/doubl/.claude/hooks/guard-destructive.py",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "/c/Users/doubl/anaconda3/python.exe ~/.claude/statusline.py"
  },
  "enabledPlugins": {
    "plugin-dev@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "polysyllogism@local-dev": true,
    "feature-forge@local-dev": true,
    "gameforge@local-dev": true,
    "coderabbit@claude-plugins-official": true,
    "sentry@claude-plugins-official": true
  },
  "effortLevel": "high",
  "autoUpdatesChannel": "latest",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark-daltonized",
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": true,
  "cleanupPeriodDays": 365
}
