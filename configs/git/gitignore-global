# Machine-only patterns. Anything a collaborator's clone also needs to ignore
# (build output, dependencies, caches, databases) belongs in that repo's own
# .gitignore, where it is visible. A global dist/ or build/ silently hides files
# a repo tracks or should track.

# === OS ===
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# === Editors ===
.vscode/.ropeproject
*.swp
*.swo
*~
.idea/
*.sublime-project
*.sublime-workspace

# === Secrets (safety net; repos should still ignore their own) ===
.env
.env.local
.env.*.local
*.pem
*.key

# === Claude Code ===
.claude/projects/
.claude/cache/
.claude/downloads/
